# Node reads this file only with: node --env-file=.env server.js
HOST=127.0.0.1
PORT=8080
# Optional JSON array overrides HOST/PORT. Omitted protocol inherits global HTTP/TLS settings.
# Each endpoint may set protocol to http or https; https may also set certFile and keyFile.
# LISTENERS=[{"host":"127.0.0.1","port":8080},{"host":"::1","port":8080,"ipv6Only":true}]
# Unix sockets (Linux/macOS): use a private parent directory outside FILES_DIR.
# LISTENERS=[{"path":"/run/file-manager/app.sock"}]
FILES_DIR=./data/files
CONFIG_DIR=./data/config
MAX_UPLOAD_BYTES=10737418240
# Upload limit 0 means unlimited. Text limits must be 1..67108864 bytes.
MAX_TEXT_BYTES=2097152
# Maximum receiving time per upload (milliseconds), 7 days by default.
UPLOAD_TIMEOUT_MS=604800000
READ_ONLY=false
# Allow external pages to embed the application. Disables ancestor/clickjacking restrictions.
# SameSite=Strict session cookies remain; cross-site embedding is not an authenticated-login workaround.
ALLOW_FRAME=false
# Extra response metadata; application security/authentication/transport headers are reserved.
# RESPONSE_HEADERS={"X-Deployment":"home","Permissions-Policy":"camera=(), microphone=()"}
RESPONSE_HEADERS={}
# Include the target's extension in newly displayed share URLs; existing links keep working.
LINK_EXTENSIONS=false
# Application logs: 0 off, 1 errors, 2 requests/startup, 3 connection diagnostics.
LOG_LEVEL=2
LOG_TIMESTAMPS=true
# Public visitors can edit files unless READ_ONLY=true. Disabled by default.
PUBLIC_MODE=false
MAX_PUBLIC_SESSIONS=1000
# Native filesystem notifications; disable on mounts with unreliable watchers.
WATCH=true
# Coalesce filesystem changes without postponing them indefinitely. 0 sends immediately.
UPDATE_INTERVAL_MS=1000
# SSE keepalive comments; 0 disables comments, not session validity checks.
KEEP_ALIVE_MS=20000
# Refresh directory sizes and connected clients periodically. 0 disables polling.
POLLING_INTERVAL_MS=15000
# JSON array of root-relative globs; use ** to match nested directories.
IGNORE_PATTERNS=[]
# Set true behind HTTPS. Keep false for direct local HTTP.
COOKIE_SECURE=false
# Optional native HTTPS: configure both PEM files. HTTPS always uses Secure cookies.
# TLS_CERT_FILE=/absolute/path/fullchain.pem
# TLS_KEY_FILE=/absolute/path/privkey.pem
