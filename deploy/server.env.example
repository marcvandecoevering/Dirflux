# Native Linux service paths. Change service ReadWritePaths/RequiresMountsFor
# together with these values when using other storage locations.
HOST=127.0.0.1
PORT=8080
FILES_DIR=/srv/file-manager/files
CONFIG_DIR=/var/lib/file-manager
PUBLIC_MODE=false
READ_ONLY=false
COOKIE_SECURE=false
WATCH=true
POLLING_INTERVAL_MS=15000
