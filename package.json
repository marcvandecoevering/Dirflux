{
  "name": "dirflux",
  "version": "0.1.0-beta.10",
  "private": true,
  "license": "BSD-2-Clause",
  "files": [
    "server.js",
    "lib/",
    "public/",
    "src/",
    "scripts/assets.js",
    "scripts/ensure-assets.js",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "LICENSE.droppy",
    "THIRD_PARTY_NOTICES.md",
    "docs/",
    "deploy/",
    "Dockerfile",
    "compose.yaml",
    ".env.example"
  ],
  "type": "module",
  "description": "Self-hosted file manager inspired by droppy",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "test:package": "node scripts/native-smoke.js",
    "package": "npm run build && node scripts/package.js",
    "candidate": "npm run build && node scripts/release-candidate.js",
    "check": "node --check server.js && node --check public/app.js",
    "build": "node scripts/assets.js",
    "prestart": "node scripts/ensure-assets.js",
    "prepack": "npm run build",
    "predev": "npm run build"
  },
  "dependencies": {
    "archiver": "8.0.0",
    "express": "5.3.0",
    "picomatch": "4.0.7"
  },
  "devDependencies": {
    "@codemirror/language-data": "6.5.2",
    "@codemirror/theme-one-dark": "6.1.3",
    "@fontsource/roboto": "5.3.0",
    "@uiw/codemirror-themes-all": "4.25.12",
    "codemirror": "6.0.2",
    "esbuild": "0.28.2",
    "pdfjs-dist": "6.4.299"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marcvandecoevering/Dirflux.git"
  },
  "homepage": "https://github.com/marcvandecoevering/Dirflux#readme",
  "bugs": {
    "url": "https://github.com/marcvandecoevering/Dirflux/issues"
  }
}
